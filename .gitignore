# ── Raw data (never commit the giant CSV/XLSX) ────────────────────────────────
src/data/raw/

# ── DuckDB database file (local only — regenerate with `python -m src.data_pipeline run`)
src/data/processed/*.duckdb

# ── Parquet snapshots ARE committed (needed for the static React/Vercel build,
# which has no server to run the Python pipeline at deploy time) ─────────────
# src/data/processed/cleaned_data.parquet   ← keep in git
# web/public/data/cleaned_data.parquet      ← keep in git (mesmo snapshot, servido pro DuckDB-WASM)

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
.env

# ── Node / Vite (dashboard React em web/) ─────────────────────────────────────
web/node_modules/
web/dist/
web/.vite/
npm-debug.log*

# ── OS / editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
